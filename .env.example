# Separate Frappe CRM instance
CRM_URL=you_url

# Preferred for a long-running agent: Frappe User API credentials.
CRM_API_KEY=your_frappe_user_api_key
CRM_API_SECRET=your_frappe_user_api_secret

# Optional fallback if your CRM installation does not expose API-key
# generation in the UI. Leave blank when using API key authentication.
# CRM_USERNAME=agent@example.com
# CRM_PASSWORD=your_password

# LLM
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
WHISPER_MODEL=gpt-4o-mini-transcribe
TTS_VOICE=alloy

# Optional, all have working defaults
LLM_MODEL=your_model_name
TAVILY_API_KEY=tavilyy_api
TTS_VOICE=alloy
TTS_MODEL=tts-1
WHISPER_MODEL=gpt-4o-mini-transcribe
TOOL_RAG_TOP_K=3
TOOL_RAG_MIN_SCORE=0.25

PORT=8005

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
# Optional -- uploads work without these too. If S3_BUCKET_NAME is left
# empty (or a filled-in bucket can't be reached), uploaded files are saved
# to the server's local disk instead (LOCAL_STORAGE_DIR, default
# ./local_uploads), and a one-time warning is logged. Set these to get
# durable, off-server storage.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL= none
LOCAL_STORAGE_DIR=

PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Agent's own mailbox (outbound only for now). Any standard SMTP provider
# works -- Gmail (use an App Password, not your normal password), Microsoft
# 365, SendGrid/SES SMTP, or a self-hosted mail server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=agent@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password
# Optional -- defaults to SMTP_USERNAME if left blank
SMTP_FROM_EMAIL=agent@example.com
SMTP_FROM_NAME=Magma Assistant
# TLS (STARTTLS on the normal SMTP port, e.g. 587) is the default. Set
# SMTP_USE_SSL=true instead for implicit SSL (e.g. port 465).
SMTP_USE_TLS=true
SMTP_USE_SSL=false


LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="magma-assistance"
REDIS_URL=